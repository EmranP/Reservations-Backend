#######################################
# Application
#######################################
NODE_ENV=development            # development | production
PORT=4000                       # Backend port
HOSTNAME=localhost              # Backend host
API_URL=http://localhost:4000   # Public backend URL

CLIENT_URL=http://localhost:5173
CLIENT_PROFILE_URL=http://localhost:5173/reset-password  # Page where user set new password

ADMIN_PASS=change_me
USER_DEFAULT_PASS=change_me


#######################################
# Expiration Settings
#######################################
# Numeric value
EXPIRES_USER_VERIFY=15
EXPIRES_USER_REMOVE_VERIFY=60
EXPIRES_USER_RESET_PASSWORD_VERIFY=15
EXPIRES_USER_TWO_FACTORY_CHALLENGE=5

# Unit: m (minutes) | h (hours) | d (days)
EXPIRES_USER_VERIFY_UNIT_CASE=m
EXPIRES_USER_REMOVE_VERIFY_UNIT_CASE=m
EXPIRES_USER_RESET_PASSWORD_VERIFY_UNIT_CASE=m
EXPIRES_USER_TWO_FACTORY_CHALLENGE_UNIT_CASE=m


#######################################
# JWT & Encryption
#######################################
JWT_ACCESS_EXPIRES=30
JWT_REFRESH_EXPIRES=7
JWT_ACCESS_EXPIRES_UNIT_CASE=m
JWT_REFRESH_EXPIRES_UNIT_CASE=d

TOKEN_ENCRYPT_KEY=your_32_or_64_char_secret


#######################################
# JSON-BIN.IO (JWKS storage)
#######################################
JSON_BIN_API_KEY=your_json_bin_api_key
JSON_BIN_API_ACCESS_KEY=your_json_bin_access_key
JSON_BIN_API_ID=your_json_bin_id


#######################################
# JWKS
#######################################
ISSUER=http://localhost:4000
AUDIENCE=your_audience
JWKS_URL=https://api.jsonbin.io/v3/b/${JSON_BIN_API_ID}
KID=your_key_id


#######################################
# Email Provider (SMTP)
#######################################
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_app_password


#######################################
# Database (PostgreSQL)
#######################################
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=postgres
DB_PASSWORD=your_db_password


#######################################
# OAuth 2.0 Google
#######################################
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_REDIRECT=http://localhost:5173/auth/google


#######################################
# OAuth 2.0 GitHub
#######################################
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CLIENT_REDIRECT=http://localhost:5173/auth/github


#######################################
# OAuth 2.0 Yandex
#######################################
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_CLIENT_REDIRECT=http://localhost:5173/auth/yandex


#######################################
# OAuth 2.0 Telegram
#######################################
TELEGRAM_BOT_ID=your_bot_id
TELEGRAM_BOT_TOKEN=your_bot_token


#######################################
# Redis
#######################################
DEFAULT_EXPIRES_TIME_REDIS=1800000


#######################################
# MinIO (S3 compatible storage)
#######################################
MINIO_END_POINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin


#######################################
# reCAPTCHA
#######################################
RE_CAPTCHA_SECRET_KEY=your_recaptcha_secret_key


#######################################
# Payment System
#######################################
PAYMENT_SHOP_ID=your_shop_id
PAYMENT_SECRET_KEY=your_payment_secret_key